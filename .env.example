# Copiar a .env y completar. Nunca versionar secretos (SRS-N02).
# En producción, cargar estos valores con `npx -y @insforge/cli secrets` o el gestor del despliegue.

# URL base del proyecto InsForge (npx -y @insforge/cli current).
BOTCENTRO_INSFORGE_URL=https://tbv7i4p3.us-east.insforge.app

# Cuenta de servicio de InsForge Auth con su rol en public.app_roles (ingest_service para
# workers de adquisición, query_service para la API y el bot). Nunca la API key administrativa.
BOTCENTRO_SERVICE_EMAIL=
BOTCENTRO_SERVICE_PASSWORD=

# Telegram (SRS §11). El token del bot vive en el gestor de secretos.
BOTCENTRO_TELEGRAM_BOT_TOKEN=
# Secreto que Telegram envía en X-Telegram-Bot-Api-Secret-Token (setWebhook secret_token, ≥16 caracteres).
BOTCENTRO_TELEGRAM_WEBHOOK_SECRET=
# ID numérico del bot (parte del token anterior a ':'); deduplicación (bot_id, update_id).
BOTCENTRO_TELEGRAM_BOT_ID=
# Validar contra la versión vigente de Bot API antes de desplegar.
BOTCENTRO_TELEGRAM_MESSAGE_LIMIT=4096
BOTCENTRO_TELEGRAM_RATE_LIMIT=10

# Claves HMAC (≥32 bytes aleatorios): seudonimización de usuarios y firma de callbacks.
BOTCENTRO_PSEUDONYM_KEY=
BOTCENTRO_CALLBACK_KEY=

# Almacenamiento local de originales (desarrollo). En producción: bucket privado de InsForge.
BOTCENTRO_OBJECT_STORE_DIR=var/objects
